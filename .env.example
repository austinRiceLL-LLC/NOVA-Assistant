# Local development only. Do not put real values in source control.
NOVA_CONNECTOR_PROVIDER=composio
COMPOSIO_API_KEY=
COMPOSIO_PROJECT_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_READ_TOOL=GMAIL_FETCH_EMAILS
COMPOSIO_GMAIL_TOOL_VERSION=20260903_00
COMPOSIO_OUTLOOK_READ_TOOL=OUTLOOK_LIST_MESSAGES
COMPOSIO_OUTLOOK_TOOL_VERSION=20260903_00
COMPOSIO_LINKEDIN_READ_TOOL=LINKEDIN_GET_MY_INFO
COMPOSIO_LINKEDIN_TOOL_VERSION=20260826_00
COMPOSIO_WEBHOOK_SECRET=
NOVA_TOOL_EXECUTION_MODE=mock
NOVA_AI_PROVIDER=openai
NOVA_AI_MODEL=gpt-6-astra
NOVA_AI_API_KEY=
NOVA_AI_BASE_URL=https://api.openai.com/v1
# JSON map of Composio toolkit slugs to existing auth config IDs, for example {"github":"ac_..."}
COMPOSIO_AUTH_CONFIGS_JSON={}
COMPOSIO_GMAIL_SEND_TOOL=GMAIL_SEND_EMAIL
COMPOSIO_GMAIL_SEND_TOOL_VERSION=20260903_00
COMPOSIO_GMAIL_ARCHIVE_TOOL=GMAIL_ARCHIVE_EMAIL
